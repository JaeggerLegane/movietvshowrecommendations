# Settings for Next Watch on your NAS. Save this file as .env in docker/nextwatch/nas.
# Fill in the lines that say FILL-IN (replace the word FILL-IN, keep the part before =), then save.

# 1. Tailscale auth key, from login.tailscale.com/admin/settings/keys (starts with tskey-auth-)
TS_AUTHKEY=FILL-IN

# 2. Password to open the app. Pick something long. Don't use the characters $ # or quotes.
APP_PASSWORD=FILL-IN

# The TMDB key is pasted in the app itself (it asks for it), so it doesn't go here.

# Nothing to change below this line (these are your rules; change them here if you ever want to).
MIN_YEAR=1970
MIN_IMDB=6
MIN_VOTES=500
COOKIE_SECURE=true
TRUST_PROXY=1
