# For running the app on a computer (not the NAS). Save as .env next to package.json.

# Password to open the app.
APP_PASSWORD=change-me-to-something-long

# TMDB key: themoviedb.org > Settings > API. Either the "API Read Access Token" (long, starts with eyJ)
# or the shorter "API Key" works.
TMDB_API_KEY=

# Your NAS folders. On Windows the network paths work as they are:
MOVIES_DIR=\\jaeggerlegane\media\libraries\movies
TV_DIR=\\jaeggerlegane\media\libraries\tv
